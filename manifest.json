{
  "manifest_version": 3,
  "name": "TabShame",
  "description": "Counts your open tabs and playfully shames you with voice when things get out of hand.",
  "version": "1.1.0",
  "permissions": ["tabs", "storage", "scripting", "alarms", "tts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabShame",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
